# URL del sitio (sin trailing slash)
# Local:      http://localhost:3000
# Producción: https://guillosgit.github.io/my-app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Configuración de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Emails autorizados para acceder (separados por comas)
NEXT_PUBLIC_AUTHORIZED_EMAILS=ejemplo@gmail.com

# Emails con permisos de administrador (separados por comas)
NEXT_PUBLIC_ADMIN_EMAIL=admin@gmail.com
