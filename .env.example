# Variables para GitHub Pages (deben ser NEXT_PUBLIC_* para que funcionen en el cliente)

# Email(s) autorizados para acceder (separados por comas)
NEXT_PUBLIC_AUTHORIZED_EMAILS=example@gmail.com

# Email(s) del administrador (tiene permisos de edición/eliminación)
# Puedes agregar múltiples emails separados por comas
NEXT_PUBLIC_ADMIN_EMAIL=example@gmail.com,otro@email.com

# Configuración de GitHub DB para persistencia de datos (opcional)
# Si no se configuran, la app usará localStorage (solo en el navegador)
# Para activar persistencia en GitHub Issues, crea un Personal Access Token en:
# https://github.com/settings/tokens (necesita permisos: repo)
NEXT_PUBLIC_GITHUB_OWNER=tu-usuario-github
NEXT_PUBLIC_GITHUB_REPO=nombre-del-repositorio
NEXT_PUBLIC_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NOTA: Para GitHub Actions, configura estos valores en:
# Settings > Secrets and variables > Actions > Repository secrets
# Los nombres de secrets solo pueden contener: A-Z, a-z, 0-9, _
# NO usar espacios ni guiones en los nombres de secrets
